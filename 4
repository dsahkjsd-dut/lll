function __PULSE_SCOPE.GameEffects.Kill.laser(state, effect)
	local environment = state.context.environment
	local color, white = environment.Color3.fromRGB(255, 30, 60), environment.Color3.new(1, 1, 1)
	local body = __PULSE_SCOPE.GameEffects.Kill.staticBody(state, effect)
	__PULSE_SCOPE.GameEffects.Kill.hideEffectBody(state, effect.char)
	local direction, right = __PULSE_SCOPE.GameEffects.Kill.cameraDirection(state)
	local ground = __PULSE_SCOPE.GameEffects.Kill.ground(state, effect.root, effect.ignore)
	local height = ground and ground.Y or effect.root.Y - 3
	local top = effect.head.Y + 0.8
	local cuts = {height + (top - height) * 0.28, height + (top - height) * 0.52, height + (top - height) * 0.76}
	local anchor = __PULSE_SCOPE.GameEffects.Kill.anchor(state, environment.CFrame.new(effect.chest), environment.Vector3.new(0.3, 0.3, 0.3))
	local emitter = __PULSE_SCOPE.GameEffects.Kill.particle(state, anchor, {Texture = state.textures.spark, Color = environment.ColorSequence.new(white, color),
		Size = __PULSE_SCOPE.GameEffects.Kill.numberSequence(state, 0, 0.5, 1, 0), Lifetime = environment.NumberRange.new(0.15, 0.3), Speed = environment.NumberRange.new(8, 16),
		SpreadAngle = environment.Vector2.new(180, 180), Drag = 5, Orientation = environment.Enum.ParticleOrientation.VelocityParallel, Brightness = 5}, 0)
	for index, y in cuts do
		local side = index % 2 == 0 and -1 or 1
		__PULSE_SCOPE.GameEffects.Kill.delay(state, (index - 1) * 0.13, function()
			local origin = environment.Vector3.new(0, 0, 0)
			local core = __PULSE_SCOPE.GameEffects.Kill.beam(state, origin, direction * 14, 0.07, white)
			local glow = __PULSE_SCOPE.GameEffects.Kill.beam(state, origin, direction * 14, 0.3, color, environment.Enum.Material.Neon, 0.45)
			__PULSE_SCOPE.GameEffects.Kill.animate(state, 0.14, function(progress)
				local position = environment.Vector3.new(effect.root.X, y, effect.root.Z) + right * (-3.5 + 7 * progress) * side
				core.CFrame = environment.CFrame.lookAt(position, position + direction)
				glow.CFrame, anchor.CFrame = core.CFrame, environment.CFrame.new(position)
				if math.abs(progress - 0.5) < 0.3 then emitter:Emit(3) end
			end, function()
				for _, beam in {core, glow} do
					__PULSE_SCOPE.GameEffects.Kill.tween(state, beam, 0.12, {Transparency = 1, Size = environment.Vector3.new(0.01, 0.01, beam.Size.Z)})
					__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, beam, 0.15)
				end
			end)
			local ring = __PULSE_SCOPE.GameEffects.Kill.disc(state, environment.CFrame.new(effect.root.X, y, effect.root.Z), 2.6, color, environment.Enum.Material.Neon, 0.4)
			__PULSE_SCOPE.GameEffects.Kill.tween(state, ring, 0.7, {Transparency = 1, Size = environment.Vector3.new(0.04, 3.2, 3.2)}, environment.Enum.EasingStyle.Quad)
			__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, ring, 0.75)
			__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.laser1, 0.6, 2 + index * 0.15, anchor)
			__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.laser2, 0.3, 2)
		end)
	end
	__PULSE_SCOPE.GameEffects.Kill.delay(state, 0.48, function()
		local levels, shifts, axes = {height, cuts[1], cuts[2], cuts[3]}, {0, 0.5, -0.8, 1.2}, {}
		for index = 1, 4 do axes[index] = environment.Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit end
		for _, part in body do
			if not part.Parent then continue end
			local section = 1
			for index, y in cuts do if part.Position.Y > y then section = index + 1 end end
			local shift = right * shifts[section]
			local fall = levels[section] - height
			local pivot = environment.Vector3.new(effect.root.X, levels[section], effect.root.Z)
			__PULSE_SCOPE.GameEffects.Kill.tween(state, part, 0.16, {CFrame = part.CFrame + shift}, environment.Enum.EasingStyle.Quad)
			__PULSE_SCOPE.GameEffects.Kill.delay(state, 0.2, function()
				if not part.Parent then return end
				local rotation = environment.CFrame.new(pivot + shift) * environment.CFrame.fromAxisAngle(axes[section], 0.5 + section * 0.15) * environment.CFrame.new(-(pivot + shift))
				__PULSE_SCOPE.GameEffects.Kill.tween(state, part, 0.45, {CFrame = rotation * part.CFrame - environment.Vector3.new(0, fall * 0.9, 0)},
					environment.Enum.EasingStyle.Quad, environment.Enum.EasingDirection.In)
			end)
		end
		__PULSE_SCOPE.GameEffects.Kill.delay(state, 0.9, function() __PULSE_SCOPE.GameEffects.Kill.fadeGhost(state, body, 0.4) end)
		__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.sear, 0.5, 1.4, anchor)
	end)
	__PULSE_SCOPE.GameEffects.Kill.light(state, anchor, color, 5, 12, 1)
	__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, anchor, 2.5)
end

function __PULSE_SCOPE.GameEffects.Kill.voidRift(state, effect)
