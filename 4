	ui.black.BackgroundTransparency = black
	ui.line.Size = environment.UDim2.new(width, 0, height, height > 0 and 3 or 0)
	ui.line.BackgroundTransparency = lineTransparency

	local noise = 0
	for _, window in ipairs({{0.6, 1.08, 1}, {1.4, 1.8, 0.8}, {16.94, 17.12, 0.45}, {23.68, 23.76, 0.3},
		{23.88, 23.96, 0.3}, {34, 34.6, 0.92}, {34.6, 35.5, 0.55}, {44.55, 44.8, 0.5}}) do
		if time >= window[1] and time < window[2] then noise = math.max(noise, window[3]) end
	end
	if noise > 0 and noise < 0.95 then noise *= 0.55 + 0.45 * math.random() end
	ui.noise.ImageTransparency = 1 - noise
	ui.noiseBackground.BackgroundTransparency = 1 - noise * 0.92
	if noise > 0 then ui.noise.Position = environment.UDim2.fromOffset(-math.random(0, 150), -math.random(0, 150)) end

	local flash = 0
	for _, event in ipairs({{16.98, 0.55, 0.18}, {34.86, 0.85, 0.35}, {1.5, 0.5, 0.2}}) do
