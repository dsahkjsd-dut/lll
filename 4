function __PULSE_SCOPE.FovRenderer.create(environment, create)
	local context = {environment = environment, create = create}

	return {
		make = function(parent) return __PULSE_SCOPE.FovRenderer.make(environment, create, parent) end,
		render = function(...) return __PULSE_SCOPE.FovRenderer.render(context, ...) end,
