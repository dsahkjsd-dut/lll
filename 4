__PULSE_SCOPE.normalizeUtf8Lower = function(str)
    if type(str) ~= "string" or str == "" then
        return ""
    end
    local s = string.lower(str)
    s = string.gsub(s, "\208([\144-\159])", function(c)
        return "\208" .. string.char(string.byte(c) + 32)
    end)
    s = string.gsub(s, "\208([\160-\175])", function(c)
        return "\209" .. string.char(string.byte(c) - 32)
    end)
    s = string.gsub(s, "\208\129", "\209\145")
    return s
end

__PULSE_SCOPE.textContainsAny = function(raw, wordList)
    local norm = __PULSE_SCOPE.normalizeUtf8Lower(raw)
    if norm == "" then
        return false
    end
    for _, w in ipairs(wordList) do
        if string.find(norm, w, 1, true) then
            return true
        end
    end
    return false
end

__PULSE_SCOPE.isGreenColor = function(col)
    if typeof(col) ~= "Color3" then
        return false
    end
    return (col.G > 0.45) and (col.G > col.R * 1.35) and (col.G > col.B * 1.35)
end

__PULSE_SCOPE.isRedColor = function(col)
    if typeof(col) ~= "Color3" then
        return false
    end
    return (col.R > 0.45) and (col.R > col.G * 1.35) and (col.R > col.B * 1.35)
end

__PULSE_SCOPE.hasRedAncestorOrSelf = function(obj)
    local cur = obj
    for _ = 1, 3 do
        if not cur or not cur:IsA("GuiObject") then
            break
        end
        if __PULSE_SCOPE.getEffectiveBgTrans(cur) < 0.95 and __PULSE_SCOPE.isRedColor(cur.BackgroundColor3) then
            return true
        end
        if cur:IsA("ImageLabel") or cur:IsA("ImageButton") then
            if __PULSE_SCOPE.getEffectiveImageTrans(cur) < 0.95 and __PULSE_SCOPE.isRedColor(cur.ImageColor3) then
                return true
            end
        end
        cur = cur.Parent
    end
    return false
end

