			__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, beam, 0.4)
			__PULSE_SCOPE.GameEffects.Kill.animate(state, 0.1, function(progress)
				local position = start:Lerp(finish, progress)
				local frame = environment.CFrame.lookAt(position, position + (finish - start))
				local targets = {}
				for partIndex, offset in clone.offsets do targets[partIndex] = frame * offset end
				__PULSE_SCOPE.GameEffects.Kill.moveParts(state, clone.parts, targets)
			end, function()
				for _, part in clone.parts do
					__PULSE_SCOPE.GameEffects.Kill.tween(state, part, 0.25, {Transparency = 1})
					__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, part, 0.3)
				end
				__PULSE_SCOPE.GameEffects.Kill.smoke(state, finish - environment.Vector3.new(0, 2.5, 0), environment.Color3.fromRGB(40, 20, 60), 4, 3, 2)
			end)
			__PULSE_SCOPE.GameEffects.Kill.arc(state, center + environment.Vector3.new(0, (index - 3) * 0.3, 0), math.random(0, 180), 3.2, 1, color, 0.6, 0.05, 0.08, math.random(-30, 30))
