	end
	local offset = 0
	for step = 0, 12 do
		local candidates = step == 0 and {0} or {-step / 2, step / 2}
		local found = false
		for _, candidate in ipairs(candidates) do
			if fits(candidate) then offset, found = candidate, true; break end
		end
