__PULSE_SCOPE.MuzzleGuard = {}

function __PULSE_SCOPE.MuzzleGuard.parts(state)
	local character = state.context.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local head = character and character:FindFirstChild("Head")
	local muzzle = root and root:FindFirstChild("GunRaycastAttachment")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not character:FindFirstChild("Gun") or not root or not head or not muzzle or not humanoid or humanoid.Health <= 0 then return nil end
	return character, root, head, muzzle, humanoid
end

function __PULSE_SCOPE.MuzzleGuard.lineClear(state, origin, finish)
	local context = state.context
	local delta = finish - origin
	local distance = delta.Magnitude
	if distance < 0.001 then return true end

	local hit = context.workspace:Raycast(origin, delta * ((distance + (state.ext or 0.6)) / distance), state.rayParams)
	if not hit then return true end
	local model = hit.Instance and hit.Instance:FindFirstAncestorOfClass("Model")
	local aim = rawget(context.environment.getgenv(), "__pulseAimX")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil and aim ~= nil and aim.target == model
end

function __PULSE_SCOPE.MuzzleGuard.nearby(state, root)
	local context, vector = state.context, state.context.environment.Vector3
	table.clear(state.nearby)
	if state.nearOff then return end
	local aim = rawget(context.environment.getgenv(), "__pulseAimX")
	local target = aim and aim.target
	for _, player in context.players:GetPlayers() do
		if player == context.player then continue end
		local character = player.Character
		if not character or character == target then continue end
		local other = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not other or not humanoid or humanoid.Health <= 0 or (other.Position - root.Position).Magnitude >= 12 then continue end
		local velocity = other.AssemblyLinearVelocity
		table.insert(state.nearby, other.Position)
		table.insert(state.nearby, other.Position + vector.new(velocity.X, 0, velocity.Z) * (state.nearLead or 0.25))
	end
	state.nearN = #state.nearby / 2
end

function __PULSE_SCOPE.MuzzleGuard.nearClear(state, origin, finish)
	local delta, vector = finish - origin, state.context.environment.Vector3
	local denominator = math.max(delta:Dot(delta), 1e-6)
	for _, position in state.nearby do
		for _, height in {1.5, 0, -1.5} do
			local point = position + vector.new(0, height, 0)
			local closest = origin + delta * math.clamp((point - origin):Dot(delta) / denominator, 0, 1)
			if (closest - point).Magnitude < (state.nearR or 2) then return false end
		end
	end
	return true
end

function __PULSE_SCOPE.MuzzleGuard.clearPose(state, frame, head, muzzle, thorough)
	local environment = state.context.environment
	local finish, origin = (frame * muzzle).Position, frame * head
	if not __PULSE_SCOPE.MuzzleGuard.lineClear(state, origin, finish) then return false end
	if not thorough then return true end

	local vector = environment.Vector3
	for _, offset in {vector.new(0.2, 0, 0), vector.new(-0.2, 0, 0), vector.new(0, 0.2, 0), vector.new(0, -0.2, 0)} do
		if not __PULSE_SCOPE.MuzzleGuard.lineClear(state, frame * (head + offset), finish) then return false end
	end
	if not __PULSE_SCOPE.MuzzleGuard.nearClear(state, origin, finish) then return false end
	if state.yawTol == false then return true end

	for _, angle in {math.rad(25), math.rad(-25)} do
		local rotated = frame * environment.CFrame.Angles(0, angle, 0)
		local from, to = rotated * head, (rotated * muzzle).Position
		if not __PULSE_SCOPE.MuzzleGuard.lineClear(state, from, to) or not __PULSE_SCOPE.MuzzleGuard.nearClear(state, from, to) then return false end
	end
	return true
end

function __PULSE_SCOPE.MuzzleGuard.findPose(state, current, head, muzzle)
	local context, environment = state.context, state.context.environment
	local frame, vector = environment.CFrame, environment.Vector3
	local look = vector.new(current.LookVector.X, 0, current.LookVector.Z)
	if look.Magnitude < 0.05 then look = vector.new(0, 0, -1) end
	local yaw, position = math.atan2(-look.X, -look.Z), current.Position
	if state.lastYaw then
		local candidate = frame.new(position) * frame.Angles(0, yaw + state.lastYaw, 0)
		if __PULSE_SCOPE.MuzzleGuard.clearPose(state, candidate, head, muzzle, true) then return candidate end
	end

	for index = 1, 23 do
		local offset = math.ceil(index / 2) * (index % 2 == 1 and 1 or -1) * math.pi / 12
		local candidate = frame.new(position) * frame.Angles(0, yaw + offset, 0)
		if not __PULSE_SCOPE.MuzzleGuard.clearPose(state, candidate, head, muzzle, false) then continue end
		if __PULSE_SCOPE.MuzzleGuard.clearPose(state, candidate, head, muzzle, true) then state.lastYaw = offset; return candidate end
	end

	for _, radius in {1, 2, 3} do
		for index = 0, 7 do
			local angle = index * math.pi / 4
			local point = position + vector.new(math.cos(angle), 0, math.sin(angle)) * radius
			if context.workspace:Raycast(position, point - position, state.rayParams) then continue end
			if #context.workspace:GetPartBoundsInBox(frame.new(point), vector.new(1.6, 4.2, 1.6), state.overlapParams) > 0 then continue end
			for rotation = 0, 11 do
				local candidate = frame.new(point) * frame.Angles(0, yaw + rotation * math.pi / 6, 0)
				if not __PULSE_SCOPE.MuzzleGuard.clearPose(state, candidate, head, muzzle, false) then continue end
				if __PULSE_SCOPE.MuzzleGuard.clearPose(state, candidate, head, muzzle, true) then return candidate end
			end
		end
	end
	return nil
end

function __PULSE_SCOPE.MuzzleGuard.reset(state)
	local hold = state.hold
	if hold.cf and hold.humanoid and hold.humanoid.Parent and hold.autoRotate ~= nil then
		pcall(function() hold.humanoid.AutoRotate = hold.autoRotate end)
	end
	hold.cf, hold.fixedPosition, hold.autoRotate, hold.humanoid, hold.root = nil, nil, nil, nil, nil
end

function __PULSE_SCOPE.MuzzleGuard.hold(state)
	local hold = state.hold
	if not hold.cf then return end
	local root = hold.root
	if not root or not root.Parent then __PULSE_SCOPE.MuzzleGuard.reset(state); return end

	local environment = state.context.environment
	local position = hold.fixedPosition or root.Position
	root.CFrame = environment.CFrame.new(position) * hold.cf.Rotation
	if hold.fixedPosition then root.AssemblyLinearVelocity = environment.Vector3.new(0, root.AssemblyLinearVelocity.Y, 0) end
end

function __PULSE_SCOPE.MuzzleGuard.poseClear(state, frame)
	local character, root, head, muzzle = __PULSE_SCOPE.MuzzleGuard.parts(state)
	if not character or state.character ~= character then return true end
	local headPosition = root.CFrame:PointToObjectSpace(head.Position)
	local pose = state.context.environment.CFrame.new(root.Position) * frame.Rotation
	return __PULSE_SCOPE.MuzzleGuard.clearPose(state, pose, headPosition, muzzle.CFrame, true)
end

function __PULSE_SCOPE.MuzzleGuard.step(state)
	local context, environment = state.context, state.context.environment
	local globals = environment.getgenv()
	local character, root, head, muzzle, humanoid = __PULSE_SCOPE.MuzzleGuard.parts(state)
	if not character or globals.__pulseManualFling or globals.__pulseTouchFlinging or globals.__pulseFlingTargetChar
		or globals.__pulseInvis and globals.__pulseInvis.active == true or globals.__pulseMuzzleOff then
		if state.hold.cf then __PULSE_SCOPE.MuzzleGuard.reset(state) end
		state.at, state.guarding = nil, false
		return
	end

	local now = environment.os.clock()
	if state.character ~= character then
		state.character = character
		state.rayParams.FilterDescendantsInstances, state.overlapParams.FilterDescendantsInstances = {character}, {character}
		state.at = nil
		__PULSE_SCOPE.MuzzleGuard.reset(state)
	end
	local current = root.CFrame
	local headPosition, muzzleFrame = current:PointToObjectSpace(head.Position), muzzle.CFrame
	state.frames += 1
	__PULSE_SCOPE.MuzzleGuard.nearby(state, root)
	local clear = __PULSE_SCOPE.MuzzleGuard.clearPose(state, current, headPosition, muzzleFrame, true)
	if not clear and not __PULSE_SCOPE.MuzzleGuard.lineClear(state, current * headPosition, (current * muzzleFrame).Position) then state.hardAt = now end

	if (state.wantUntil or 0) > now then
		if not clear and now >= (state.nextFind or 0) then
			local candidate = __PULSE_SCOPE.MuzzleGuard.findPose(state, current, headPosition, muzzleFrame)
			if not candidate then state.nextFind = now + (state.findGap or 0.1) end
			if candidate then
				local hold = state.hold
				if not hold.cf then hold.autoRotate, hold.humanoid = humanoid.AutoRotate, humanoid end
				humanoid.AutoRotate = false
				hold.cf, hold.root = candidate, root
				local delta = candidate.Position - current.Position
				hold.fixedPosition = environment.Vector3.new(delta.X, 0, delta.Z).Magnitude > 0.3 and candidate.Position or nil
				root.CFrame = candidate
				state.guardFrames, clear = state.guardFrames + 1, true
			end
		end
		globals.__pulseShotHold = math.max(tonumber(globals.__pulseShotHold) or 0, now + 0.2)
	end
	if (state.wantUntil or 0) <= now and state.hold.cf then __PULSE_SCOPE.MuzzleGuard.reset(state) end
	state.guarding = state.hold.cf ~= nil

	local antiAim = state.aaWait ~= false and rawget(globals, "__pulseAntiAim")
	local spoofRecent = antiAim and antiAim.sideAt and now - antiAim.sideAt < 0.03
	if spoofRecent and clear and environment.typeof(antiAim.fakeCF) == "CFrame" and state.aaCheck ~= false then
		local pose = environment.CFrame.new(current.Position) * antiAim.fakeCF.Rotation
		if __PULSE_SCOPE.MuzzleGuard.clearPose(state, pose, headPosition, muzzleFrame, true) then spoofRecent = false end
	end
	state.spoofRecent = not not spoofRecent
	if clear then
		if state.blocked or not state.at or spoofRecent then state.clearSince = now end
		state.blocked = false
	end
	if not clear then
		if not state.blocked then state.blockedAt = now end
		state.blocked, state.blockedFrames = true, state.blockedFrames + 1
	end
	state.at = now
end

function __PULSE_SCOPE.MuzzleGuard.install(context)
	local environment, globals = context.environment, context.environment.getgenv()
	local state = {context = context, alive = true, clearSince = 0, blocked = false, guarding = false,
		frames = 0, guardFrames = 0, blockedFrames = 0, nearby = {}, hold = {}}
	state.rayParams = environment.RaycastParams.new()
	state.rayParams.FilterType = environment.Enum.RaycastFilterType.Exclude
	state.overlapParams = environment.OverlapParams.new()
	state.overlapParams.FilterType, state.overlapParams.RespectCanCollide = environment.Enum.RaycastFilterType.Exclude, true
	state.request = function(duration) state.wantUntil = math.max(state.wantUntil or 0, environment.os.clock() + (duration or 0.5)) end
	state.poseClear = function(frame) return __PULSE_SCOPE.MuzzleGuard.poseClear(state, frame) end
	globals.__pulseMuzzle = state

	context.connect(context.runService.Heartbeat, function() pcall(__PULSE_SCOPE.MuzzleGuard.hold, state) end)
	context.connect(context.runService.PreSimulation, function()
		pcall(__PULSE_SCOPE.MuzzleGuard.hold, state)
		if not pcall(__PULSE_SCOPE.MuzzleGuard.step, state) then state.at = nil end
	end)
	pcall(function() context.runService:UnbindFromRenderStep("PulseMuzzleHold") end)
	pcall(function() context.runService:BindToRenderStep("PulseMuzzleHold", environment.Enum.RenderPriority.Camera.Value + 1,
		function() pcall(__PULSE_SCOPE.MuzzleGuard.hold, state) end) end)
	return state, function()
		pcall(__PULSE_SCOPE.MuzzleGuard.reset, state)
		state.alive = false
		pcall(function() context.runService:UnbindFromRenderStep("PulseMuzzleHold") end)
	end
end

__PULSE_SCOPE.SkinModel = {}

function __PULSE_SCOPE.SkinModel.decode(environment, value)
	if type(value) ~= "table" then return value end
	local kind = value[1]
	if kind == "V" then return environment.Vector3.new(value[2], value[3], value[4]) end
	if kind == "C" then return environment.Color3.new(value[2], value[3], value[4]) end
	if kind == "F" then return environment.CFrame.new(table.unpack(value, 2, 13)) end
	if kind == "NR" then return environment.NumberRange.new(value[2], value[3]) end
	if kind == "E" then
		local ok, item = pcall(function() return environment.Enum[value[2]][value[3]] end)
		return ok and item or nil
	end
	if kind == "CS" then
		local points = {}
		for index = 2, #value do
			local point = value[index]
			table.insert(points, environment.ColorSequenceKeypoint.new(point[1], environment.Color3.new(point[2], point[3], point[4])))
		end
		local ok, sequence = pcall(environment.ColorSequence.new, points)
		return ok and sequence or nil
	end
	if kind == "NS" then
		local points = {}
		for index = 2, #value do
			local point = value[index]
			table.insert(points, environment.NumberSequenceKeypoint.new(point[1], point[2], point[3] or 0))
		end
		local ok, sequence = pcall(environment.NumberSequence.new, points)
		return ok and sequence or nil
	end
	return nil
end

function __PULSE_SCOPE.SkinModel.frame(environment, values)
	return environment.CFrame.new(table.unpack(values, 1, 12))
end

function __PULSE_SCOPE.SkinModel.mesh(state, meshId)
	if state.meshes[meshId] then return state.meshes[meshId]:Clone() end
	while state.loading[meshId] do state.context.environment.task.wait() end
	if state.meshes[meshId] then return state.meshes[meshId]:Clone() end

	state.loading[meshId] = true
	local environment = state.context.environment
	local ok, result = pcall(function()
		return state.context.insertService:CreateMeshPartAsync(meshId, environment.Enum.CollisionFidelity.Box, environment.Enum.RenderFidelity.Automatic)
	end)
	state.loading[meshId] = nil
	if not ok or not result then return nil end
	state.meshes[meshId] = result
	return result:Clone()
end

function __PULSE_SCOPE.SkinModel.node(state, data, root, references, unresolved, options)
	if options and options.skip and options.skip(data) then return nil end
	local context, environment = state.context, state.context.environment
	local object
	if data.c == "MeshPart" then
		object = __PULSE_SCOPE.SkinModel.mesh(state, data.p.MeshId or "")
		if not object then object = environment.Instance.new("Part"); object.Transparency = 1 end
	end
	if not object then
		local ok, created = pcall(environment.Instance.new, data.c)
		if not ok or not created then return nil end
		object = created
	end
	object.Name = data.n
	for property, value in data.p or {} do
		if property == "MeshId" and data.c == "MeshPart" then continue end
		if type(value) == "table" and value[1] == "R" then
			table.insert(unresolved, {object, property, value[2]})
			continue
		end
		local decoded = __PULSE_SCOPE.SkinModel.decode(environment, value)
		if decoded ~= nil then pcall(function() object[property] = decoded end) end
	end
	if data.i then references[data.i] = object end
	if object:IsA("BasePart") then
		object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch, object.Massless = false, false, false, false, true
		pcall(function() object.AudioCanCollide = false end)
		if root and data.r then
			local weld = environment.Instance.new("Weld")
			weld.Name, weld.Part0, weld.Part1, weld.C0, weld.Parent = "PW", root, object, __PULSE_SCOPE.SkinModel.frame(environment, data.r), object
		end
	end
	for key, value in data.a or {} do pcall(object.SetAttribute, object, key, __PULSE_SCOPE.SkinModel.decode(environment, value)) end
	for _, tag in data.t or {} do pcall(context.collection.AddTag, context.collection, object, tag) end
	local parentRoot = root or object
	for _, child in data.k or {} do
		local built = __PULSE_SCOPE.SkinModel.node(state, child, parentRoot, references, unresolved, options)
		if built then built.Parent = object end
	end
	return object
end

function __PULSE_SCOPE.SkinModel.build(state, data, options)
	local references, unresolved = {}, {}
	local root = __PULSE_SCOPE.SkinModel.node(state, data, nil, references, unresolved, options)
	if not root then return nil end
	for _, reference in unresolved do
		local target = references[reference[3]]
		if target then pcall(function() reference[1][reference[2]] = target end) end
	end
	return root
end

function __PULSE_SCOPE.SkinModel.hasChroma(data)
	for _, tag in data.t or {} do
		if tag == "ChromaPart" or tag == "ChromaDecal" or tag == "ChromaFire" then return true end
	end
	for _, child in data.k or {} do if __PULSE_SCOPE.SkinModel.hasChroma(child) then return true end end
	return false
end

function __PULSE_SCOPE.SkinModel.applyChroma(state, skin, model)
	if not skin.ch or __PULSE_SCOPE.SkinModel.hasChroma(skin.d) then return end
	for _, object in model:GetDescendants() do
		if object:IsA("Decal") and object.Name:lower():find("chroma") then pcall(state.context.collection.AddTag, state.context.collection, object, "ChromaDecal") end
		if object:IsA("Fire") then pcall(state.context.collection.AddTag, state.context.collection, object, "ChromaFire") end
	end
end

__PULSE_SCOPE.SkinCatalog = {}
__PULSE_SCOPE.SKIN_RARITY_ORDER = {Pulse = 0, Ancient = 1, Unique = 2, Godly = 3, Classic = 4, Legendary = 5, Rare = 6}

function __PULSE_SCOPE.SkinCatalog.list(database)
	local result = {}
	for key, entry in database do
		local name = entry.nm or key
		table.insert(result, {key = key, name = name, short = entry.ch and name:gsub("^Chroma ", "") or name,
			chroma = entry.ch == true, type = entry.t, rarity = entry.r, img = entry.img})
	end
	table.sort(result, function(first, second)
		local firstRank = (__PULSE_SCOPE.SKIN_RARITY_ORDER[first.rarity] or 9) + (first.chroma and 0.5 or 0)
		local secondRank = (__PULSE_SCOPE.SKIN_RARITY_ORDER[second.rarity] or 9) + (second.chroma and 0.5 or 0)
		if firstRank ~= secondRank then return firstRank < secondRank end
		if first.type ~= second.type then return first.type < second.type end
		return first.name:lower() < second.name:lower()
	end)
	return result
end

function __PULSE_SCOPE.SkinCatalog.filter(items, kind, rarity, query)
	local result = {}
	query = (query or ""):gsub("^%s+", ""):gsub("%s+$", ""):lower()
	for _, item in items do
		if kind ~= "All" and item.type ~= kind then continue end
		if rarity ~= "Any" and not (rarity == "Chroma" and item.chroma) and not (item.rarity == rarity and not item.chroma) then continue end
		if query ~= "" and not (tostring(item.name) .. " " .. tostring(item.key)):lower():find(query, 1, true) then continue end
		table.insert(result, item)
	end
	return result
end

