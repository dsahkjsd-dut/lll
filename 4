			local beam = __PULSE_SCOPE.GameEffects.Kill.beam(state, start + environment.Vector3.new(0, 1, 0), finish + environment.Vector3.new(0, 1, 0), 0.25, color, environment.Enum.Material.Neon, 0.3)
