		__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.fleshSlash, 0.9, 0.8)
		__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.punch, 0.6, 1.2)
		__PULSE_SCOPE.GameEffects.Kill.shakeCamera(state, center, 1, 0.3)
		__PULSE_SCOPE.GameEffects.Kill.delay(state, 1.2, function()
			local position = body and body.torso and body.torso.Parent and body.torso.Position or effect.root
			__PULSE_SCOPE.GameEffects.Kill.splat(state, position, 4, environment.Color3.fromRGB(125, 0, 12), 2.4, effect.ignore, 1)
		end)
