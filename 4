			end
		end
		if time >= 22.28 and time <= 22.96 then jump = 0.55 * math.abs(math.sin(math.pi * (time - 22.28) / 0.34)) end
		if time >= 22.98 and time <= 23.86 then jump = math.max(jump, 0.3 * math.abs(math.sin(math.pi * (time - 22.98) / 0.29))) end
		if time >= 15.9 and time <= 16.7 then headAngle -= 0.28 * math.abs(math.sin((time - 15.9) * 12)) end
		soundOnce("grunt", 15.15, 0.6)
	end
	if time >= 25.2 then
		soundOnce("squeal", 25.2, 1)
		local elapsed = time - 25.2
		local towards = environment.Vector3.new(rootPlane.X - plan.spot.X, 0, rootPlane.Z - plan.spot.Z)
		local away = plan.away - plan.spot
		direction = towards.Unit:Lerp(away.Unit, smooth(elapsed / 0.3))
		local progress = math.clamp((elapsed - 0.25) / 1.8, 0, 1)
		position = plan.spot:Lerp(plan.away, progress)
		local phase = elapsed * 2 * math.pi * 4
		stride, bounce, headAngle = math.sin(phase) * 0.8 * (elapsed > 0.25 and 1 or 0), math.abs(math.sin(phase)) * 0.09, 0.1
