			__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.whooshQuick, 0.7, 1 + index * 0.1)
		end)
	end
	__PULSE_SCOPE.GameEffects.Kill.delay(state, 1, function()
		if body then
			body.release(environment.Vector3.new(0, 45, 0), nil)
			pcall(function() body.torso.AssemblyAngularVelocity = __PULSE_SCOPE.GameEffects.Kill.randomVector(state, 10) end)
		end
		__PULSE_SCOPE.GameEffects.Kill.flash(state, center, color, 12, 5)
