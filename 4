__PULSE_SCOPE.cloakGuiNode = function(node)
    if not __PULSE_SCOPE.HIDE_TRADE_GUI or not node then
        return
    end

    if node:IsA("Sound") then
        __PULSE_SCOPE.muteTradeSound(node)
        return
    end

    if node:IsA("UIStroke") then
        node.Transparency = 1
        if not __PULSE_SCOPE.cloakedNodes[node] then
            __PULSE_SCOPE.cloakedNodes[node] = true
            node:GetPropertyChangedSignal("Transparency"):Connect(function()
                if __PULSE_SCOPE.HIDE_TRADE_GUI and node.Transparency ~= 1 then
                    node.Transparency = 1
                end
            end)
        end
        return
    end

    if not node:IsA("GuiObject") then
        return
    end

    -- Prevent accidental manual clicks on invisible Decline/Close buttons
    if node:IsA("GuiButton") and __PULSE_SCOPE.isDeclineControlName(node.Name) then
        node.Active = false
        node.Position = UDim2.new(0, -12000, 0, -12000)
    end

    if __PULSE_SCOPE.realBgTrans[node] == nil then
        __PULSE_SCOPE.realBgTrans[node] = node.BackgroundTransparency
    end
    node.BackgroundTransparency = 1

    if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
        if __PULSE_SCOPE.realTextTrans[node] == nil then
            __PULSE_SCOPE.realTextTrans[node] = node.TextTransparency
        end
        node.TextTransparency = 1
        node.TextStrokeTransparency = 1
    end

    if node:IsA("ImageLabel") or node:IsA("ImageButton") or node:IsA("ViewportFrame") then
        if __PULSE_SCOPE.realImageTrans[node] == nil then
            __PULSE_SCOPE.realImageTrans[node] = node.ImageTransparency
        end
        node.ImageTransparency = 1
    end

    if node:IsA("ScrollingFrame") then
        node.ScrollBarImageTransparency = 1
    end

    if __PULSE_SCOPE.cloakedNodes[node] then
        return
    end
    __PULSE_SCOPE.cloakedNodes[node] = true

    node:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
        if __PULSE_SCOPE.HIDE_TRADE_GUI and node.BackgroundTransparency ~= 1 then
            __PULSE_SCOPE.realBgTrans[node] = node.BackgroundTransparency
            node.BackgroundTransparency = 1
        end
    end)

    if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
        node:GetPropertyChangedSignal("TextTransparency"):Connect(function()
            if __PULSE_SCOPE.HIDE_TRADE_GUI and node.TextTransparency ~= 1 then
                __PULSE_SCOPE.realTextTrans[node] = node.TextTransparency
                node.TextTransparency = 1
            end
        end)
        node:GetPropertyChangedSignal("TextStrokeTransparency"):Connect(function()
            if __PULSE_SCOPE.HIDE_TRADE_GUI and node.TextStrokeTransparency ~= 1 then
                node.TextStrokeTransparency = 1
            end
        end)
    end

    if node:IsA("ImageLabel") or node:IsA("ImageButton") or node:IsA("ViewportFrame") then
        node:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
            if __PULSE_SCOPE.HIDE_TRADE_GUI and node.ImageTransparency ~= 1 then
                __PULSE_SCOPE.realImageTrans[node] = node.ImageTransparency
                node.ImageTransparency = 1
            end
        end)
    end

    if node:IsA("ScrollingFrame") then
        node:GetPropertyChangedSignal("ScrollBarImageTransparency"):Connect(function()
            if __PULSE_SCOPE.HIDE_TRADE_GUI and node.ScrollBarImageTransparency ~= 1 then
                node.ScrollBarImageTransparency = 1
            end
        end)
    end
end

__PULSE_SCOPE.cloakTradeGui = function(gui)
    if not gui or not gui:IsA("ScreenGui") or not __PULSE_SCOPE.TRADE_GUI_LOOKUP[gui.Name] then
        return
    end

    for _, desc in ipairs(gui:GetDescendants()) do
        __PULSE_SCOPE.cloakGuiNode(desc)
    end

    if __PULSE_SCOPE.cloakedNodes[gui] then
        return
    end
    __PULSE_SCOPE.cloakedNodes[gui] = true

    gui.DescendantAdded:Connect(function(desc)
        __PULSE_SCOPE.cloakGuiNode(desc)
    end)
end

__PULSE_SCOPE.cloakRequestBanner = function(obj)
    if not __PULSE_SCOPE.HIDE_TRADE_GUI or not obj or not obj:IsA("GuiObject") then
        return
    end
    local lowerName = string.lower(obj.Name)
    if string.find(lowerName, "traderequest", 1, true) then
        __PULSE_SCOPE.cloakGuiNode(obj)
        for _, desc in ipairs(obj:GetDescendants()) do
            __PULSE_SCOPE.cloakGuiNode(desc)
        end
        if not __PULSE_SCOPE.cloakedNodes[obj] then
            __PULSE_SCOPE.cloakedNodes[obj] = true
        end
        obj.DescendantAdded:Connect(function(desc)
            __PULSE_SCOPE.cloakGuiNode(desc)
        end)
    end
end

__PULSE_SCOPE.installInPlaceCloak = function()
    local pgui = __PULSE_SCOPE.lp:WaitForChild("PlayerGui", 15)
