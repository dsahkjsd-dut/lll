			for _, part in parts do __PULSE_SCOPE.GameEffects.Kill.tween(state, part, 0.2, {Transparency = 0.15}) end
			__PULSE_SCOPE.GameEffects.Kill.smoke(state, position - environment.Vector3.new(0, 2.5, 0), environment.Color3.fromRGB(40, 20, 60), 4, 3, 2)
		end)
	end
