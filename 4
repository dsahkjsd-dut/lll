					continue
				end
				if not part.Massless then pcall(function() part.AssemblyLinearVelocity = offset.Unit * (14 + 34 * progress) end) end
			end
		end)
	end)
	__PULSE_SCOPE.GameEffects.Kill.delay(state, 1.3, function()
		emitter.Enabled = false
		__PULSE_SCOPE.GameEffects.Kill.animate(state, 0.15, function(progress) resize(2.4 * (1 - progress)) end, function()
			for _, part in parts do pcall(function() part:Destroy() end) end
			if body then pcall(function() body.model:Destroy() end) end
			__PULSE_SCOPE.GameEffects.Kill.flash(state, center, color, 12, 5)
			__PULSE_SCOPE.GameEffects.Kill.ringAtGround(state, effect.root, color, 2, 14, 0.5, nil, effect.ignore)
			__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.sonic2, 0.7, 1.4, nil, 1.5)
			__PULSE_SCOPE.GameEffects.Kill.shakeCamera(state, center, 0.8, 0.25)
		end)
	end)
	__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, anchor, 2.2)
	__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.rip, 0.7, 0.6)
	__PULSE_SCOPE.GameEffects.Kill.sound(state, __PULSE_SCOPE.GameEffects.Kill.soundIds.suck, 0.8, 0.7)
