		floor = floor, hipHeight = hipHeight, homeDistance = (origin - base):Dot(normal), homeOffset = (origin - base):Dot(lateral),
		statueDistance = statueDistance, statueOffset = (statuePosition - base):Dot(lateral),
		frame = environment.CFrame.lookAt(base + height, base + height + normal)}
end

