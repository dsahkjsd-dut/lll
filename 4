function __PULSE_SCOPE.GameEffects.Kill.impact(state, effect)
	local environment = state.context.environment
	local color, white = environment.Color3.fromRGB(255, 200, 110), environment.Color3.new(1, 1, 1)
	local direction, fallback = __PULSE_SCOPE.GameEffects.Kill.direction(state, effect)
	local source = effect.killer and effect.killer.Parent and effect.killer.Position + environment.Vector3.new(0, 0.6, 0) or fallback
	local delta = effect.chest - source
	local shot = delta.Magnitude > 0.1 and delta.Unit or direction
	local up = math.abs(shot.Y) < 0.95 and environment.Vector3.new(0, 1, 0) or environment.Vector3.new(1, 0, 0)
	local frame = environment.CFrame.fromMatrix(effect.chest, shot:Cross(up).Unit, shot)

	if delta.Magnitude > 1 and delta.Magnitude < 250 then
		local core = __PULSE_SCOPE.GameEffects.Kill.beam(state, source, effect.chest, 0.1, environment.Color3.fromRGB(255, 245, 220))
		local glow = __PULSE_SCOPE.GameEffects.Kill.beam(state, source, effect.chest, 0.4, color, environment.Enum.Material.Neon, 0.6)
		for _, part in {core, glow} do
			__PULSE_SCOPE.GameEffects.Kill.tween(state, part, 0.2, {Transparency = 1, Size = environment.Vector3.new(0.02, 0.02, part.Size.Z)}, environment.Enum.EasingStyle.Quad)
			__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, part, 0.25)
		end
	end

	for index = 1, 2 do
		__PULSE_SCOPE.GameEffects.Kill.delay(state, (index - 1) * 0.05, function()
			local disc = __PULSE_SCOPE.GameEffects.Kill.disc(state, frame + shot * (index - 1) * 1.4, 0.4, white, environment.Enum.Material.Neon, 0.25)
			__PULSE_SCOPE.GameEffects.Kill.tween(state, disc, 0.3, {Size = environment.Vector3.new(0.04, 7 - index, 7 - index), Transparency = 1}, environment.Enum.EasingStyle.Quad)
			__PULSE_SCOPE.GameEffects.Kill.destroyLater(state, disc, 0.35)
		end)
	end

	local anchor = __PULSE_SCOPE.GameEffects.Kill.anchor(state, frame, environment.Vector3.new(0.5, 0.5, 0.5))
	local attachment = environment.Instance.new("Attachment")
	attachment.Parent = anchor
	local sequence = function(...) return __PULSE_SCOPE.GameEffects.Kill.numberSequence(state, ...) end
	local colors = function(first, second) return environment.ColorSequence.new(first, second or first) end
	__PULSE_SCOPE.GameEffects.Kill.particle(state, attachment, {Texture = state.textures.sparkBright, Color = colors(white), Size = sequence(0, 5, 1, 0),
		Lifetime = environment.NumberRange.new(0.12), Brightness = 6, ZOffset = 2}, 1)
	__PULSE_SCOPE.GameEffects.Kill.particle(state, attachment, {Texture = state.textures.fsparks, Color = colors(white, color), Size = sequence(0, 0.5, 1, 0),
		Lifetime = environment.NumberRange.new(0.3, 0.6), Speed = environment.NumberRange.new(30, 55), SpreadAngle = environment.Vector2.new(25, 25),
		Drag = 3, Orientation = environment.Enum.ParticleOrientation.VelocityParallel, Brightness = 5}, 30)
	__PULSE_SCOPE.GameEffects.Kill.particle(state, attachment, {Texture = state.textures.splat,
		Color = colors(environment.Color3.fromRGB(170, 0, 20), environment.Color3.fromRGB(90, 0, 10)), Size = sequence(0, 0.5, 1, 0.2),
		Lifetime = environment.NumberRange.new(0.5, 0.8), Speed = environment.NumberRange.new(14, 26), SpreadAngle = environment.Vector2.new(30, 30),
		Acceleration = environment.Vector3.new(0, -60, 0), Rotation = environment.NumberRange.new(0, 360), LightEmission = 0, Brightness = 1}, 22)

