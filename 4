	once("jump", 3.25, function()
		sound("whoosh", "torso", 1.2)
		local origin = statue.originalFrame.Position
		dust(origin + vector.new(0, -3, 0), 14, 2.6)
		ring(origin + vector.new(0, -2.9, 0), nil, color.fromRGB(230, 224, 210), 1, 9, 0.45)
	end)
	once("land", 4.4, function()
		local point = vector.new(fight.landing.X, floor + 0.15, fight.landing.Z)
		sound("quake", "torso", 1.5)
		sound("heavy", "torso", 1.3)
		sound("debris", "torso", 1)
		ring(point, nil, color.fromRGB(240, 232, 214), 2, 24, 0.55, "wave")
		ring(point + vector.new(0, 0.1, 0), nil, white, 1, 14, 0.35)
		dust(point + vector.new(0, 0.6, 0), 26, 3.2)
		rocks(point + vector.new(0, 0.4, 0), 18)
		shake(point, 1.1, 0.7)
	end)
	for index, moment in ipairs({5.05, 5.45, 5.85}) do
		once("step" .. index, moment, function()
			sound("step", "torso", 1.1, 0.8)
			sound("heavy", "torso", 0.5, 1.2)
			dust(vector.new(fight.position.X, floor + 0.4, fight.position.Z), 6, 1.4)
			shake(fight.position, 0.25, 0.25)
		end)
	end
	once("slash", 6.2, function()
		sound("slash", "torso", 1.3)
		if statue.weapon then
			emit(statue.weapon.CFrame, {texture = "crescent", c0 = white, c1 = color.fromRGB(200, 220, 255),
				s0 = 4.5, s1 = 6, l0 = 0.22, n = 1, le = 1, br = 3, spread = 0, a0 = 0.05, fade = 0.3})
		end
