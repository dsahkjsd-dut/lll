function __PULSE_SCOPE.FarmRuntime.Webhook.install(context)
	local environment = context.environment
	local now = environment.os.clock()
	local state = {context = context, cfg = __PULSE_SCOPE.FarmRuntime.Webhook.load(context), lastSent = now, lastSess = 0, startAt = now, sent = 0, kickAt = 0}
	state.send = function(kind, reason) return __PULSE_SCOPE.FarmRuntime.Webhook.send(state, kind, reason) end
	state.onKick = function(reason) __PULSE_SCOPE.FarmRuntime.Webhook.onKick(state, reason) end
	environment.getgenv().__pulseFarmWebhook = state
	environment.getgenv().__pulseFarmWebhookUI = function(section) __PULSE_SCOPE.FarmRuntime.Webhook.controls(state, section) end
	environment.task.spawn(function() __PULSE_SCOPE.FarmRuntime.Webhook.getIcons(state) end)
	environment.task.spawn(function()
		while not state.closed and context.isAlive() do
			environment.task.wait(5)
			pcall(__PULSE_SCOPE.FarmRuntime.Webhook.step, state)
		end
	end)
	__PULSE_SCOPE.FarmRuntime.Webhook.controls(state)
	return state, function() state.closed = true end
end

