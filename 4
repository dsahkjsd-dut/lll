			end
		end
	end
	direction = environment.Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.001 then direction = environment.Vector3.new(0, 0, -1) end
	local unit = pig.unit
	local bodyFrame = environment.CFrame.lookAt(position, position + direction.Unit) * environment.CFrame.new(0, 10 * unit + bounce + jump, 0)
	pig.body.CFrame = bodyFrame
	local headFrame = bodyFrame * environment.CFrame.new(0, 0.5 * unit, -8 * unit)
		* environment.CFrame.Angles(headAngle, 0, 0) * environment.CFrame.new(0, 1.5 * unit, -4 * unit)
	pig.head.CFrame = headFrame
	for _, attachment in ipairs(pig.attached) do attachment[1].CFrame = headFrame * attachment[2] end
	for _, leg in ipairs(pig.legs) do
		local angle = leg.phase == 0 and stride or -stride
		leg.part.CFrame = bodyFrame * environment.CFrame.new(leg.x, -4 * unit, leg.z)
			* environment.CFrame.Angles(angle, 0, 0) * environment.CFrame.new(0, -3 * unit, 0)
	end
