	local root = state.root.Position
	local rootPlane = environment.Vector3.new(root.X, 0, root.Z)
	local stride, bounce, jump = 0, 0, 0
	local position, direction, headAngle
	local function soundOnce(name, moment, volume)
		if time < moment or plan.fired[name] then return end
