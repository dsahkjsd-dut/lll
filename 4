	local black, height, width, lineTransparency = 0, 0, 1, 1
	local start, finish = 0.55, 44.8
	if time >= start and time < start + 0.4 then
		local elapsed = time - start
		height = math.clamp(elapsed / 0.18, 0, 1)
		lineTransparency = elapsed < 0.2 and 0 or math.clamp((elapsed - 0.2) / 0.2, 0, 1)
		black = elapsed < 0.17 and 0 or 1
