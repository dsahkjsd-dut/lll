__PULSE_SCOPE.inspectFunctionForTokens = function(fn, depth)
    depth = depth or 1
    if depth > 3 or type(fn) ~= "function" then
        return
    end
    if islclosure and not islclosure(fn) then
        return
    end

    if type(debug) == "table" and type(debug.getupvalues) == "function" then
        local okUp, ups = pcall(debug.getupvalues, fn)
        if okUp and type(ups) == "table" then
            for _, v in pairs(ups) do
                if type(v) == "number" then
                    __PULSE_SCOPE.registerAuthenticToken(v)
                elseif type(v) == "function" then
                    __PULSE_SCOPE.inspectFunctionForTokens(v, depth + 1)
                end
            end
        end
    end
end

