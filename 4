function __PULSE_SCOPE.PulseApplication.Trolly.televisionSound(state, television, name, location, volume, speed, direct, duration)
	local environment = state.context.environment
	local statue = television.statue
	local parents = {voice = television.voice, guide = state.root, torso = statue.parts.Torso,
		head = statue.parts.Head, source = television.source:FindFirstChild("Torso"),
		hand = state.model:FindFirstChild("RightHand"), guideHead = state.model:FindFirstChild("Head"),
		guideHand = state.model:FindFirstChild("RightHand") and state.root,
		voiceHand = state.model:FindFirstChild("RightHand") and television.voice}
	local parent = parents[location]
	local id = __PULSE_SCOPE.PulseApplication.Trolly.televisionSoundIds[name]
	if not id or not parent or not parent.Parent then return end
	local playback = (speed or 1) * (direct and 1 or 1 + (math.random() - 0.5) * 0.08)
	local sound = __PULSE_SCOPE.PulseApplication.Trolly.create(state, "Sound", {SoundId = "rbxassetid://" .. id,
		Volume = volume or 1, PlaybackSpeed = playback, SoundGroup = __PULSE_SCOPE.PulseApplication.Trolly.soundGroup(state),
		RollOffMode = environment.Enum.RollOffMode.InverseTapered, RollOffMinDistance = 16, RollOffMaxDistance = 140}, parent)
	sound:Play()
	environment.task.delay(duration or 6, function()
		if not direct then sound:Destroy(); return end
		pcall(function() state.context.tweenService:Create(sound, environment.TweenInfo.new(0.15), {Volume = 0}):Play() end)
		environment.task.delay(0.16, function() sound:Destroy() end)
	end)
end

