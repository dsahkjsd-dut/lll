	local emitter = __PULSE_SCOPE.GameEffects.Kill.particle(state, anchor, {Texture = state.textures.spark, Color = environment.ColorSequence.new(white, color),
		Size = __PULSE_SCOPE.GameEffects.Kill.numberSequence(state, 0, 0.5, 1, 0.1), Lifetime = environment.NumberRange.new(0.35, 0.5), Speed = environment.NumberRange.new(12, 18),
		Shape = environment.Enum.ParticleEmitterShape.Sphere, ShapeStyle = environment.Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = environment.Enum.ParticleEmitterShapeInOut.Inward, Orientation = environment.Enum.ParticleOrientation.VelocityParallel, Brightness = 4}, 0)
	emitter.Rate, emitter.Enabled = 90, true
	__PULSE_SCOPE.GameEffects.Kill.light(state, anchor, color, 6, 18, 1.8)
	__PULSE_SCOPE.GameEffects.Kill.delay(state, 0.35, function()
		if body then body.release(environment.Vector3.new(0, 2, 0), nil) end
		__PULSE_SCOPE.GameEffects.Kill.animate(state, 0.9, function(progress)
