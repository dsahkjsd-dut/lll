function __PULSE_SCOPE.PulseApplication.Trolly.televisionSustainedEffects(state, television, time)
	local trolly = __PULSE_SCOPE.PulseApplication.Trolly
	local color = state.context.environment.Color3
	if time > 42.62 and time < 43.42 then
		if trolly.effectStars(state, television, television.statue.parts.Head, time, 1) then
			trolly.televisionSound(state, television, "chimes", "head", 0.9, 1.2)
		end
	end
	if time >= 43.42 and television.stars then
		television.stars:Destroy()
		television.stars, television.starAttachments = nil, nil
	end
	local hand = state.model:FindFirstChild("RightHand")
	if time >= 43.1 and time < 43.44 and hand then
		local colors = {color.fromRGB(150, 255, 170), color.fromRGB(40, 220, 90), color.fromRGB(80, 255, 120)}
		if trolly.effectCharge(state, television, hand, colors) then trolly.televisionSound(state, television, "power", "hand", 1) end
	end
	if time >= 43.44 and television.charge then
		television.charge:Destroy()
		television.charge = nil
	end
end

function __PULSE_SCOPE.PulseApplication.Trolly.fightOnce(fight, name, time, moment, callback)
	if time < moment or fight.fired[name] then return end
	fight.fired[name] = true
	callback()
end

function __PULSE_SCOPE.PulseApplication.Trolly.fightEvents(state, fight, time)
	local trolly = __PULSE_SCOPE.PulseApplication.Trolly
	local environment = state.context.environment
	local vector, frame, color = environment.Vector3, environment.CFrame, environment.Color3
	local statue, direction = fight.statue, fight.direction
	local torso = statue.parts.Torso.Position
	local root = state.root.Position
	local head = state.model:FindFirstChild("Head")
	local floor = fight.floor
	local function once(name, moment, callback) trolly.fightOnce(fight, name, time, moment, callback) end
	local function sound(name, location, volume, speed)
		pcall(trolly.televisionSound, state, fight, name, location, volume, speed)
	end
	local function dust(position, count, size, tint) trolly.televisionDust(state, fight, position, count, size, tint) end
	local function rocks(position, count) trolly.effectRocks(state, fight, position, count) end
	local function ring(position, angle, tint, first, last, duration, texture)
		trolly.effectRing(state, fight, position, angle, tint, first, last, duration, texture)
	end
	local function shake(position, magnitude, duration) trolly.televisionShake(state, fight, position, magnitude, duration) end
	local function emit(position, options) trolly.televisionEmit(state, fight, position, options) end
	local white = color.fromRGB(255, 255, 255)
	if time > 0.3 and time < 2.9 and time * 10 % 1 < 0.12 then rocks(torso + vector.new(0, -1.5, 0), 2) end
	once("rumble", 0.35, function()
		sound("rumble", "torso", 1.4)
		shake(torso, 0.35, 2.4)
	end)
	once("eyes", 2.2, function()
		for _, eye in ipairs(statue.eyes) do eye.Enabled = true end
		pcall(function() state.context.tweenService:Create(statue.light, environment.TweenInfo.new(0.4), {Brightness = 3}):Play() end)
		sound("crack", "torso", 1.3)
		dust(torso + vector.new(0, -2.6, 0), 10, 2.2)
	end)
	once("roar", 2.75, function()
		sound("roar", "head", 1.6)
		sound("growl", "head", 0.9)
